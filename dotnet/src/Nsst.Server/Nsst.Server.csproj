<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Nsst.Server</RootNamespace>
    <AssemblyName>Nsst.Server</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nsst.Core\Nsst.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The built console, embedded rather than served from disk so the executable stays
      self-contained.

      The directory is web/vite.config.ts's outDir. It is a build artifact, produced by
      `npm run build` in web/ before this project is published, so a publish from a clean
      checkout needs that step to have run — see the Makefile.

      The logical name is normalised to a forward-slash prefix in WebUiAssets, because
      MSBuild expands %(RecursiveDir) with the host's directory separator.
    -->
    <EmbeddedResource Include="..\..\..\web\dist\**\*">
      <LogicalName>nsst.webui/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nsst.Server.Tests" />
  </ItemGroup>

</Project>
